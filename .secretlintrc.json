{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "generic credentials",
            "pattern": "/(password|passwd|pwd|secret|token|api_?key)\\s*[=:]\\s*(?!process\\.env|import\\.meta\\.env|\\$)['\"`]?[^\\s'\"`]{6,}/i"
          }
        ]
      }
    },
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    }
  ]
}
